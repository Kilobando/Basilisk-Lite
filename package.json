{
  "name": "basilisk-lite",
  "version": "1.0.0",
  "description": "Privacy-first peer-to-peer messenger with a self-hosted WebSocket relay.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "relay": "node relay/server.js",
    "lint": "node scripts/check.js",
    "desktop": "electron desktop/main.js",
    "package:win": "electron-packager . BasiliskLite --platform=win32 --arch=x64 --out=dist --overwrite",
    "package:mac": "electron-packager . BasiliskLite --platform=darwin --arch=arm64 --out=dist --overwrite",
    "package:linux": "electron-packager . BasiliskLite --platform=linux --arch=x64 --out=dist --overwrite"
  },
  "keywords": [
    "messenger",
    "p2p",
    "privacy",
    "websocket",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-packager": "^17.1.2"
  }
}
